# API
PORT=3000
DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant
JWT_ACCESS_SECRET=remplacez-par-une-longue-valeur-aleatoire
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173
# URL publique de l'API (liens vers les logos / favicons) et de l'application web (lien « mot de passe oublié »)
PUBLIC_API_URL=http://localhost:3000
APP_URL=http://localhost:5173
# Dossier des fichiers envoyés (logos, favicons, avatars) — à placer sur un volume persistant
UPLOAD_DIR=uploads
# Clé de chiffrement des secrets 2FA (32 caractères min). OBLIGATOIRE en production :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=
# Secret HMAC des liens de suivi de commande (tickets), 32 caractères min, différent des autres. OBLIGATOIRE en production.
# Le changer invalide les liens déjà imprimés (24 h de durée de vie après clôture).
TRACKING_TOKEN_SECRET=
# Nombre de proxys de confiance devant l'API (IP réelle pour la limitation de débit) : 0 si l'API est exposée sans proxy
TRUST_PROXY=1
# Documentation Swagger /api/docs (défaut : on hors production, off en production)
#SWAGGER=off
# Cookie du jeton de rafraîchissement « Secure » (défaut : on en production)
#COOKIE_SECURE=on

# Seed (compte SuperAdmin) — obligatoire en production
SEED_SUPERADMIN_EMAIL=superadmin@restaurant.local
SEED_SUPERADMIN_PASSWORD=

# Notifications (X1) — par défaut tout est journalisé (aucun envoi réel)
# Email : log | smtp (compatible Brevo, Mailjet, Gmail SMTP…)
MAIL_DRIVER=log
#SMTP_URL=smtp://utilisateur:motdepasse@smtp-relay.brevo.com:587
MAIL_FROM=no-reply@localhost
# SMS : log | twilio | http (agrégateur HTTP générique)
SMS_DRIVER=log
#SMS_FROM=MonResto
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#SMS_HTTP_URL=https://api.exemple-sms.com/v1/send
#SMS_HTTP_METHOD=POST
#SMS_HTTP_HEADERS={"Authorization":"Bearer <jeton>"}
#SMS_HTTP_CONTENT_TYPE=json
#SMS_HTTP_BODY={"to":"{{to}}","from":"{{from}}","text":"{{message}}"}
# File d'envoi : sync (sans Redis, développement) | bullmq (production, 5 reprises à intervalle croissant)
NOTIFICATIONS_QUEUE=sync
REDIS_URL=redis://localhost:6379
NOTIFICATIONS_RETRY_BASE_MS=30000

# Fichiers (X4) : disk (UPLOAD_DIR, défaut) | s3 (AWS S3, Cloudflare R2, MinIO, Scaleway, OVH…)
STORAGE_DRIVER=disk
#S3_BUCKET=
#S3_REGION=us-east-1            # « auto » pour Cloudflare R2
#S3_ENDPOINT=https://<compte>.r2.cloudflarestorage.com   # vide = AWS
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=on          # défaut : on si S3_ENDPOINT est défini
#S3_PUBLIC_URL=https://cdn.exemple.com   # bucket lisible publiquement ; vide = l'API relaie /uploads (bucket privé)

# Exploitation (X4) — voir docs/DEPLOIEMENT.md
# Journaux : json (défaut en production) | text
#LOG_FORMAT=json
# Dérogations explicites (à éviter) : MAIL_DRIVER=log en production ; rôle SQL superuser / BYPASSRLS en production (RLS ignorée)
#ALLOW_MAIL_LOG=on
#ALLOW_PRIVILEGED_DB=on

# Plus tard
CLOUDINARY_URL=
