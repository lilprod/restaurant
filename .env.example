# API
PORT=3000
DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant
JWT_ACCESS_SECRET=remplacez-par-une-longue-valeur-aleatoire
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173
# URL publique de l'API (liens vers les logos / favicons) et de l'application web (lien « mot de passe oublié »)
PUBLIC_API_URL=http://localhost:3000
APP_URL=http://localhost:5173
# Dossier des fichiers envoyés (logos, favicons, avatars) — à placer sur un volume persistant
UPLOAD_DIR=uploads
# Clé de chiffrement des secrets 2FA (32 caractères min). OBLIGATOIRE en production :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=

# Seed (compte SuperAdmin) — obligatoire en production
SEED_SUPERADMIN_EMAIL=superadmin@restaurant.local
SEED_SUPERADMIN_PASSWORD=

# Notifications (X1) — par défaut tout est journalisé (aucun envoi réel)
# Email : log | smtp (compatible Brevo, Mailjet, Gmail SMTP…)
MAIL_DRIVER=log
#SMTP_URL=smtp://utilisateur:motdepasse@smtp-relay.brevo.com:587
MAIL_FROM=no-reply@localhost
# SMS : log | twilio | http (agrégateur HTTP générique)
SMS_DRIVER=log
#SMS_FROM=MonResto
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#SMS_HTTP_URL=https://api.exemple-sms.com/v1/send
#SMS_HTTP_METHOD=POST
#SMS_HTTP_HEADERS={"Authorization":"Bearer <jeton>"}
#SMS_HTTP_CONTENT_TYPE=json
#SMS_HTTP_BODY={"to":"{{to}}","from":"{{from}}","text":"{{message}}"}
# File d'envoi : sync (sans Redis, développement) | bullmq (production, 5 reprises à intervalle croissant)
NOTIFICATIONS_QUEUE=sync
REDIS_URL=redis://localhost:6379
NOTIFICATIONS_RETRY_BASE_MS=30000

# Plus tard
CLOUDINARY_URL=
