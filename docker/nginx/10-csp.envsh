# shellcheck shell=sh
# Sourcé par l'entrypoint nginx AVANT le remplissage des gabarits : calcule les origines autorisées par la CSP
# à partir de PUBLIC_API_URL (origine des images téléversées) et, si le bucket est public, de S3_PUBLIC_URL.
# Refuse de démarrer sur une valeur douteuse : ces valeurs finissent dans un en-tête de sécurité.
csp_origin() {
  case "$1" in
    "") return 0 ;;
    http://*|https://*) ;;
    *) echo "CSP : « $1 » n'est pas une URL http(s)" >&2; return 1 ;;
  esac
  o="$(printf '%s' "$1" | sed -E 's#^(https?://[^/]+).*#\1#')"
  if ! printf '%s' "$o" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]+)?$'; then
    echo "CSP : origine invalide « $o »" >&2; return 1
  fi
  printf '%s' "$o"
}
CSP_API_ORIGIN="$(csp_origin "${PUBLIC_API_URL:-}")" || exit 1
CSP_CDN_ORIGIN="$(csp_origin "${S3_PUBLIC_URL:-}")" || exit 1
case "$CSP_API_ORIGIN" in
  https://*) CSP_API_WSS="wss://${CSP_API_ORIGIN#https://}" ;;
  http://*)  CSP_API_WSS="ws://${CSP_API_ORIGIN#http://}" ;;
  *)         CSP_API_WSS="" ;;
esac
export CSP_API_ORIGIN CSP_CDN_ORIGIN CSP_API_WSS
