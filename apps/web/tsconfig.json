{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@restaurant/api-client": ["../../packages/api-client/src/index.ts"],
      "@restaurant/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@restaurant/ui-tokens": ["../../packages/ui-tokens/src/index.ts"],
      "@restaurant/utils": ["../../packages/utils/src/index.ts"],
      "@restaurant/validation": ["../../packages/validation/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
