{
  "name": "restaurant",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:seed": "pnpm --filter api seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@nestjs/core",
      "esbuild"
    ],
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "multer@>=2.0.0 <2.5.0": "^2.5.0",
      "qs@>=6.7.0 <6.16.1": "^6.16.1",
      "js-yaml@>=5.0.0 <5.4.1": "^5.4.1",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "vite@>=6.0.0 <6.4.5": "^6.4.5",
      "tinypool@<2.1.2": "^2.1.2"
    }
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
