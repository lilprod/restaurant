# Configuration de production (docker-compose.prod.yml). Copiez ce fichier en `.env`, remplissez-le, ne le commitez JAMAIS.
# Générer un secret : openssl rand -hex 24      (les mots de passe de base n'acceptent que [A-Za-z0-9._~-], 16 caractères minimum)
# Guide complet : docs/DEPLOIEMENT.md

# ── Domaine et URL ──
# Domaine racine : les restaurants sont servis sur <slug>.<APP_DOMAIN> (DNS joker *.<APP_DOMAIN> + certificat joker).
# Figé dans le JavaScript du site au build : changez-le => reconstruisez (docker compose build web).
APP_DOMAIN=monapp.com
# Adresse « principale » du site (liens des emails). Aussi l'origine qui sert les fichiers téléversés (/uploads) : PUBLIC_API_URL.
APP_URL=https://app.monapp.com
PUBLIC_API_URL=https://app.monapp.com
# Navigateur -> web -> API sur la MÊME origine (cookie de session SameSite=Strict) : pas de CORS à ouvrir. Ne servez pas l'API sur un autre site.
#CORS_ORIGIN=https://app.monapp.com
# Nombre RÉEL de proxys devant l'API : 1 = seulement le nginx du conteneur web ; 2 = + un terminateur TLS / répartiteur de charge devant lui.
# Trop bas : toutes les requêtes semblent venir du proxy ; trop haut : un client peut falsifier son IP (limitation de débit contournée).
TRUST_PROXY=2
# Port publié par le conteneur web (HTTP clair, à placer derrière un terminateur TLS). WEB_BIND=0.0.0.0 pour l'exposer directement.
#WEB_BIND=127.0.0.1
#WEB_PORT=8080
#SWAGGER=off
#COOKIE_SECURE=on
# Étiquette des images (retour arrière : redéployer l'étiquette précédente)
#APP_VERSION=2026.11.1

# ── Base de données ──
# Compte d'administration du serveur PostgreSQL (création des rôles, sauvegardes). Jamais utilisé par l'API.
PG_ADMIN_PASSWORD=
# Propriétaire des tables (migrations) et rôle de l'API (sans superuser, sans BYPASSRLS : la RLS s'applique). Créés par scripts/deploy/migrate.sh.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
#DB_NAME=restaurant
REDIS_PASSWORD=

# ── Secrets applicatifs : 3 valeurs DIFFÉRENTES, 32 caractères minimum ──
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
TRACKING_TOKEN_SECRET=

# ── Premier SuperAdmin (créé seulement si aucun compte plateforme n'existe) ──
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ── Email (obligatoire : l'API refuse de démarrer avec MAIL_DRIVER=log en production) ──
MAIL_DRIVER=smtp
SMTP_URL=
MAIL_FROM=no-reply@monapp.com
#ALLOW_MAIL_LOG=on      # dérogation explicite : aucun email réel ne partira

# ── SMS : log | twilio | http (voir .env.example) ──
SMS_DRIVER=log
#SMS_FROM=
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#SMS_HTTP_URL=
#SMS_HTTP_METHOD=POST
#SMS_HTTP_HEADERS=
#SMS_HTTP_CONTENT_TYPE=json
#SMS_HTTP_BODY=

# ── Notifications push web de l'équipe (X5B) : vide = désactivé. Clés : node scripts/ops/gen-vapid-keys.mjs ──
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:contact@monapp.com

# ── Fichiers téléversés (logos, photos) : disk (volume « uploads ») ou stockage objet compatible S3 ──
STORAGE_DRIVER=disk
#S3_BUCKET=
#S3_REGION=us-east-1
#S3_ENDPOINT=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=
#S3_PUBLIC_URL=

# ── Sauvegardes (service « backup ») ──
# Heure quotidienne (UTC). Chiffrement : phrase secrète (à conserver HORS du serveur, sans elle les sauvegardes sont illisibles)
# ou, mieux, clé publique age (BACKUP_AGE_RECIPIENT=age1… ; la clé privée n'est jamais sur le serveur).
BACKUP_AT=02:30
BACKUP_PASSPHRASE=
#BACKUP_AGE_RECIPIENT=
# Copie hors site (S3 compatible), rétention distante par règle de cycle de vie du bucket
#BACKUP_S3_BUCKET=
#BACKUP_S3_PREFIX=restaurant-backups
#BACKUP_S3_ENDPOINT=
#BACKUP_S3_REGION=us-east-1
#BACKUP_S3_ACCESS_KEY_ID=
#BACKUP_S3_SECRET_ACCESS_KEY=
